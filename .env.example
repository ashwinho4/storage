# Supabase Storage Configuration
# Copy this file to .env and fill in your actual values

# Supabase S3 Storage Endpoint
SUPABASE_STORAGE_ENDPOINT=https://gjihfsstquukbkespeae.storage.supabase.co/storage/v1/s3

# Supabase S3 Access Keys
# These will be provided by Render's environment variables
SUPABASE_ACCESS_KEY_ID=your_access_key_id_here
SUPABASE_SECRET_ACCESS_KEY=your_secret_access_key_here

# Bucket name (default: uploads)
SUPABASE_BUCKET_NAME=uploads

# Server Port
PORT=3000
